# flyhypo secrets — copy to `.env` and fill in. NEVER commit your real .env.

# neuPrint token. Log in at https://neuprint.janelia.org with a Google account,
# then click your name (top-right) → "Account" and copy the auth token.
# (Default dataset hemibrain:v1.2.1 needs no special access.)
NEUPRINT_APPLICATION_CREDENTIALS=

# Google Gemini API key for the synthesis step. Get one at
# https://aistudio.google.com (AI Studio → "Get API key"). GOOGLE_API_KEY also works.
GEMINI_API_KEY=

# --- optional ---
# NEUPRINT_SERVER=neuprint.janelia.org
# FLYHYPO_MODEL=gemini-2.5-pro
# FLYHYPO_CACHE_DIR=.flyhypo_cache
# FLYHYPO_VERIFY_STRICT=0     # lenient literature gate: soft failures downgrade (not drop)
# FLYHYPO_NT_ENRICH=0         # disable borrowing predicted NT from a sibling connectome
# FLYHYPO_NT_DONOR=male-cns:v1.0   # which dataset to borrow NT predictions from
# FLYWIRE_DATA_DIR=/path/to/flywire   # dir with the static Codex export
#   (classification.csv[.gz] + connections.csv[.gz]); enables FlyWire/FAFB as a
#   4th --replicate dataset. Download from https://codex.flywire.ai (we do NOT
#   scrape Codex — this is the official static export).

# A SECOND LLM family enables the cross-family faithfulness judge in the verification
# layer (so it isn't Gemini grading Gemini). Without it, verbatim + citation + grading
# still run; the LLM support-check is simply skipped.
# DEEPSEEK_API_KEY=sk-...
# FLYHYPO_SEMANTIC=1                                # rank retrieved abstracts by embedding
#                                                   #   similarity to the cell's functional question
# PAPER_EVIDENCE_EMBED_MODEL=gemini-embedding-001   # embedding model for FLYHYPO_SEMANTIC
# FLYHYPO_SNOWBALL=1                                # expand recall via references + citations of
#                                                   #   the top hits (Semantic Scholar)
# FLYHYPO_RECALL_AUDIT=1                            # print a coverage number: a survey's references
#                                                   #   diffed against what we retrieved (+ the misses)
# SEMANTIC_SCHOLAR_API_KEY=...                      # avoids 429s during snowball / recall-audit (free)
